# BlueMetrics Playbook — variaveis de ambiente
# Copie para .env.local e ajuste. Nunca commite segredos.

# Base URL do HubSpot (portal). Usada nos deep-links e no card CRM da home.
# Ex.: https://app.hubspot.com/contacts/SEU_PORTAL_ID
NEXT_PUBLIC_HUBSPOT_BASE_URL=https://app.hubspot.com

# URL de destino do card CRM na home (deep-link direto pro HubSpot).
# Se vazio, cai no fallback do NEXT_PUBLIC_HUBSPOT_BASE_URL.
NEXT_PUBLIC_CRM_URL=
