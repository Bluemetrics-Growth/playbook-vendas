# BlueMetrics Playbook — variaveis de ambiente
# Copie para .env.local e ajuste. Nunca commite segredos.

# Base URL do HubSpot (portal). Usada no botao "Abrir o HubSpot" do playbook de CRM.
# Ex.: https://app.hubspot.com/contacts/SEU_PORTAL_ID
NEXT_PUBLIC_HUBSPOT_BASE_URL=https://app.hubspot.com

# URL do painel de mensuracao ABM (dashboard do HubSpot). Usada na tela Mensuracao.
NEXT_PUBLIC_HUBSPOT_DASHBOARD_URL=https://app.hubspot.com/reports-dashboard/22531017/view/21740275
